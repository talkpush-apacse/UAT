NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=a-random-32-char-secret-for-signing-cookies
MCP_API_KEY=your-mcp-api-key

# Mixpanel project token (client-side, safe to expose) — page view / click
# analytics for the admin tool and tester-facing pages. Leave unset to
# disable tracking entirely (also no-ops outside NODE_ENV=production).
NEXT_PUBLIC_MIXPANEL_TOKEN=

# DEV/TEST ONLY — set to "true" to skip the /admin login screen locally for
# automated verification. Only works when NODE_ENV isn't "production". NEVER
# set this in Vercel. Leave blank/unset for normal local development.
E2E_ADMIN_BYPASS=
